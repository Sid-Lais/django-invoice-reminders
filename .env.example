# Copy to .env and fill in. Real environment variables always take precedence.

# --- Mailtrap Email API (transactional stream) -------------------------------
# API token with "Email Sending" permission: Mailtrap > Settings > API Tokens
MAILTRAP_API_TOKEN=
# Must be on a domain verified in Mailtrap > Sending Domains
MAIL_FROM_EMAIL=billing@yourdomain.com
# Random secret that becomes part of the webhook URL:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MAILTRAP_WEBHOOK_TOKEN=
# Optional: the webhook's signing secret from Mailtrap. When set, the
# Mailtrap-Signature header (HMAC-SHA256 of the body) is verified.
MAILTRAP_WEBHOOK_SIGNING_SECRET=

# --- Django -------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Your time zone and the default for new clients. Each client has their own
# time zone in the admin; reminders follow the client's local date.
TIME_ZONE=Asia/Kolkata
# Local hours (in each client's time zone) when reminders may be sent.
# Run send_payment_reminders every hour.
REMINDER_SEND_HOURS=9-18
SITE_URL=http://localhost:8000
# Optional: put the SQLite file somewhere else (e.g. a persistent volume)
# SQLITE_PATH=/var/data/invoices.sqlite3

# --- Business details (shown on the PDF and in emails) -----------------------
# Only the business name is printed: no address, email or payment details.
